{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@engine/*": ["src/engine/*"],
      "@content/*": ["src/content/*"],
      "@state/*": ["src/state/*"],
      "@ui/*": ["src/ui/*"]
    }
  },
  "include": ["vite.config.ts", "src/sim"]
}
